{% extends 'layouts/page.njk' %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% block content %}
  {% if success %}
    {{ govukNotificationBanner({ type: 'success', titleText: success.title, text: success.text, attributes: { 'data-testid': 'success-banner' } }) }}
  {% endif %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l" data-testid="page-caption">{{ caption }}</span>
      <h1 class="govuk-heading-l" data-testid="page-heading">{{ heading }}</h1>

      <dl class="govuk-summary-list" data-testid="interim-site-summary">
        {% for row in rows %}
          <div class="govuk-summary-list__row" data-testid="row-{{ row.id }}">
            <dt class="govuk-summary-list__key" data-testid="row-{{ row.id }}-label">{{ row.label }}</dt>
            <dd class="govuk-summary-list__value" data-testid="row-{{ row.id }}-value">{{ row.value }}</dd>
            <dd class="govuk-summary-list__actions">
              {% if row.changeUrl %}
                <a class="govuk-link" href="{{ row.changeUrl }}" data-testid="change-{{ row.id }}">{{ t('pages.manageChangeRequests.respond.actions.change') }}<span class="govuk-visually-hidden"> {{ row.label }}</span></a>
              {% endif %}
            </dd>
          </div>
        {% endfor %}
      </dl>

      <a href="{{ continueUrl }}" role="button" draggable="false" class="govuk-button" data-module="govuk-button" data-testid="continue-button">{{ continueLabel }}</a>
    </div>
  </div>
{% endblock %}
