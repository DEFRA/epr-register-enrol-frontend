{% extends 'layouts/page.njk' %}

{#
  RA-698: the queried ORS's location. The address can be changed; country and
  coordinates are shown greyed out, as the query leaves them as they are.
#}
{% macro field(id, name, label, value, error, extraClass) %}
  <div class="govuk-form-group{% if error %} govuk-form-group--error{% endif %}">
    <label class="govuk-label" for="{{ id }}">{{ label }}</label>
    {% if error %}
      <p class="govuk-error-message"><span class="govuk-visually-hidden">{{ t('common.error') }}:</span> {{ error }}</p>
    {% endif %}
    <input class="govuk-input{% if extraClass %} {{ extraClass }}{% endif %}{% if error %} govuk-input--error{% endif %}" id="{{ id }}" name="{{ name }}" type="text" value="{{ value }}" data-testid="{{ id }}-input">
  </div>
{% endmacro %}

{% macro lockedField(id, label, value, hint) %}
  <div class="govuk-form-group">
    <label class="govuk-label" for="{{ id }}">{{ label }}</label>
    <div class="govuk-hint">{{ hint }}</div>
    <input class="govuk-input" id="{{ id }}" type="text" value="{{ value }}" disabled aria-disabled="true" data-testid="locked-{{ id }}">
  </div>
{% endmacro %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errors | length %}
        <div class="govuk-error-summary" data-module="govuk-error-summary" data-testid="error-summary">
          <div role="alert">
            <h2 class="govuk-error-summary__title">{{ t('common.errorSummaryTitle') }}</h2>
            <div class="govuk-error-summary__body">
              <ul class="govuk-list govuk-error-summary__list">
                {% for name in ['addressLine1', 'addressLine2', 'townOrCity', 'stateOrRegion', 'postcode'] %}
                  {% if errors[name] %}<li><a href="#{{ name }}">{{ errors[name] }}</a></li>{% endif %}
                {% endfor %}
              </ul>
            </div>
          </div>
        </div>
      {% endif %}

      <span class="govuk-caption-l" data-testid="page-caption">{{ applicationHeader.captionText }}</span>
      <h1 class="govuk-heading-l" data-testid="page-heading">{{ heading }}</h1>

      <form method="post" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}">

        {{ field('addressLine1', 'addressLine1', t('pages.addOverseasSite.siteLocation.addressLine1Label'), fields.addressLine1, errors.addressLine1) }}
        {{ field('addressLine2', 'addressLine2', t('pages.addOverseasSite.siteLocation.addressLine2Label'), fields.addressLine2, errors.addressLine2) }}
        {{ field('townOrCity', 'townOrCity', t('pages.addOverseasSite.siteLocation.townOrCityLabel'), fields.townOrCity, errors.townOrCity, 'govuk-input--width-20') }}
        {{ field('stateOrRegion', 'stateOrRegion', t('pages.addOverseasSite.siteLocation.stateOrRegionLabel'), fields.stateOrRegion, errors.stateOrRegion, 'govuk-input--width-20') }}
        {{ field('postcode', 'postcode', t('pages.addOverseasSite.siteLocation.postcodeLabel'), fields.postcode, errors.postcode, 'govuk-input--width-10') }}

        {{ lockedField('country', t('pages.addOverseasSite.siteLocation.countryLabel'), locked.country, lockedHint) }}
        {{ lockedField('coordinates', t('pages.addOverseasSite.siteLocation.coordinatesLabel'), locked.coordinates, lockedHint) }}

        <button type="submit" class="govuk-button" data-module="govuk-button" data-testid="continue-button">{{ continueButton }}</button>
      </form>
      <a href="{{ cancelUrl }}" class="govuk-link" data-testid="cancel-link">{{ cancelLink }}</a>
    </div>
  </div>
{% endblock %}
