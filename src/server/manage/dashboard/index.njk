{% extends 'layouts/page.njk' %}

{% from "task-card/macro.njk" import appTaskCard, appInactiveLink %}

{% block content %}
  <h1 class="govuk-heading-xl" data-testid="page-heading">{{ heading }}</h1>

  <div class="govuk-grid-row govuk-!-margin-bottom-6">
    {# RA-425: loadManagePage only lets an Approved registration through. #}
    <div class="govuk-grid-column-one-half" data-testid="registration-summary">
      <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-2">
        {{ t('pages.manageDashboard.registrationLabel') }}
        <strong class="govuk-tag govuk-tag--green" data-testid="registration-status-tag">{{ t('pages.manageDashboard.registrationApproved') }}</strong>
      </p>
      <p class="govuk-body">
        <span class="govuk-!-font-weight-bold">{{ t('pages.manageDashboard.registrationNumberLabel') }}</span>
        <span data-testid="registration-number">{{ registrationNumber }}</span>
      </p>
    </div>
    <div class="govuk-grid-column-one-half" data-testid="accreditation-summary">
      <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-2">
        {{ t('pages.manageDashboard.accreditationLabel') }}
        <strong class="govuk-tag {{ accreditationStatusTag.classes }}" data-testid="accreditation-status-tag">{{ accreditationStatusTag.text }}</strong>
      </p>
      <p class="govuk-body">
        <span class="govuk-!-font-weight-bold">{{ t('pages.manageDashboard.accreditationNumberLabel') }}</span>
        <span data-testid="accreditation-number">{{ accreditationNumber }}</span>
      </p>
    </div>
  </div>

  <div class="app-waste-balance govuk-!-margin-bottom-8" data-testid="waste-balance">
    <div class="app-waste-balance__headline">
      <p class="govuk-heading-l app-waste-balance__value govuk-!-margin-bottom-0" data-testid="waste-balance-value">{{ t('pages.manageDashboard.wasteBalanceNotAvailable') }}</p>
      <p class="govuk-heading-s app-waste-balance__caption govuk-!-margin-bottom-0">{{ t('pages.manageDashboard.wasteBalanceCaption') }}</p>
    </div>
    <p class="govuk-body app-waste-balance__hint govuk-!-margin-bottom-0">{{ t('pages.manageDashboard.wasteBalanceHint') }}</p>
  </div>

  <h2 class="govuk-heading-l">{{ t('pages.manageDashboard.chooseATask') }}</h2>

  <div class="govuk-grid-row app-task-card__row">
    {% call appTaskCard({ id: 'summary-log', title: t('pages.manageDashboard.summaryLog.title'), description: t('pages.manageDashboard.summaryLog.description') }) %}
      {{ appInactiveLink('upload-summary-log-link', t('pages.manageDashboard.summaryLog.uploadLink')) }}
    {% endcall %}
    {% call appTaskCard({ id: 'perns', title: t('pages.manageDashboard.perns.title'), description: t('pages.manageDashboard.perns.description') }) %}
      {{ appInactiveLink('create-pern-link', t('pages.manageDashboard.perns.createLink')) }}
      {{ appInactiveLink('manage-perns-link', t('pages.manageDashboard.perns.manageLink')) }}
    {% endcall %}
  </div>

  <div class="govuk-grid-row app-task-card__row">
    {% call appTaskCard({ id: 'reports', title: t('pages.manageDashboard.reports.title'), description: t('pages.manageDashboard.reports.description') }) %}
      {{ appInactiveLink('manage-reports-link', t('pages.manageDashboard.reports.manageLink')) }}
    {% endcall %}
    {% call appTaskCard({ id: 'registration-accreditation', title: t('pages.manageDashboard.registrationAccreditation.title'), description: t('pages.manageDashboard.registrationAccreditation.description') }) %}
      <p class="govuk-body">
        <a href="{{ manageRegistrationAccreditationUrl }}" class="govuk-link" data-testid="manage-registration-accreditation-link">{{ t('pages.manageDashboard.registrationAccreditation.manageLink') }}</a>
      </p>
      <p class="govuk-body">
        {{ t('pages.manageDashboard.registrationAccreditation.contactPrefix') }}
        <a href="{{ contactUrl }}" class="govuk-link" data-testid="contact-regulator-link">{{ t('pages.manageDashboard.registrationAccreditation.contactLink') }}</a>.
      </p>
    {% endcall %}
  </div>
{% endblock %}
