{% extends 'layouts/page.njk' %}

{% from "overseas-site-row/macro.njk" import interimSiteDisclosure %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}

{# RA-492 and RA-682: where an ORS stands in the operator's in-year change
   requests. RA-814: each link is rendered on its own, so later flows can add
   theirs to a row beside these. #}
{% macro siteActions(site) %}
  {% if site.hasActions %}
    <div class="app-ors-table__actions">
      {% if site.pending %}
        <strong class="govuk-tag govuk-tag--yellow" data-testid="site-status-tag-{{ site.siteId }}">{{ t('pages.manageOverseasSites.status.pending') }}</strong>
      {% elif site.inProgress %}
        <strong class="govuk-tag govuk-tag--blue" data-testid="site-status-tag-{{ site.siteId }}">{{ t('pages.manageOverseasSites.status.inProgress') }}</strong>
      {% endif %}
      {% if site.viewUrl %}
        <a class="govuk-link" href="{{ site.viewUrl }}" data-testid="view-request-{{ site.siteId }}">{{ t('pages.manageOverseasSites.viewChangeRequests') }}<span class="govuk-visually-hidden"> {{ site.siteName }}</span></a>
      {% endif %}
      {% if site.changeUrl %}
        <a class="govuk-link" href="{{ site.changeUrl }}" data-testid="change-site-{{ site.siteId }}">{{ t('pages.manageOverseasSites.change') }}<span class="govuk-visually-hidden"> {{ site.siteName }}</span></a>
      {% endif %}
      {% if site.addUrl %}
        {# Adding a site changes the draft request, so this is a crumb-protected
           POST styled as a link. #}
        <form method="post" action="{{ site.addUrl }}">
          <input type="hidden" name="crumb" value="{{ crumb }}">
          <button type="submit" class="select-overseas-sites-link-button select-overseas-sites-link-button--blue govuk-body govuk-!-margin-bottom-0" data-testid="add-to-accreditation-{{ site.siteId }}">{{ t('pages.manageOverseasSites.addToAccreditation') }}<span class="govuk-visually-hidden"> {{ site.siteName }}</span></button>
        </form>
      {% endif %}
    </div>
  {% endif %}
{% endmacro %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {# RA-425: wider than two-thirds, so the title wraps after
         "reprocessing", as in Figma. #}
      <div class="app-ors-heading">
        <span class="govuk-caption-l" data-testid="page-caption">{{ caption }}</span>
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-6" data-testid="page-heading">{{ heading }}</h1>
      </div>
    </div>
  </div>

  {% if pendingCount > 0 %}
    <div class="govuk-notification-banner app-notification-banner--full-width" role="region" aria-labelledby="pending-change-title" data-module="govuk-notification-banner" data-testid="pending-change-banner">
      <div class="govuk-notification-banner__header">
        <h2 class="govuk-notification-banner__title" id="pending-change-title">{{ t('pages.manageOverseasSites.pendingBanner.title') }}</h2>
      </div>
      <div class="govuk-notification-banner__content">
        <p class="govuk-body">{{ t('pages.manageOverseasSites.pendingBanner.body', { count: pendingCount }) }}</p>
      </div>
    </div>
  {% endif %}

  {% if readyForSubmissionCount > 0 %}
    <div class="govuk-notification-banner" role="region" aria-labelledby="requests-banner-title" data-module="govuk-notification-banner" data-testid="requests-banner">
      <div class="govuk-notification-banner__header">
        <h2 class="govuk-notification-banner__title" id="requests-banner-title">{{ t('pages.manageOverseasSites.requestsBanner.title') }}</h2>
      </div>
      <div class="govuk-notification-banner__content">
        <p class="govuk-body">
          {{ t('pages.manageOverseasSites.requestsBanner.body', { count: readyForSubmissionCount }) }}
          {% if requestsUrl %}<br><a class="govuk-notification-banner__link" href="{{ requestsUrl }}" data-testid="view-requests-link">{{ t('pages.manageOverseasSites.requestsBanner.link') }}</a>{% endif %}
        </p>
      </div>
    </div>
  {% endif %}

  <p class="govuk-body" data-testid="overseas-sites-intro">{{ t('pages.manageOverseasSites.' + ('introRegistrationOnly' if isRegistrationOnly else 'intro')) }}</p>

  {% if sites.length %}
    <p class="govuk-body" data-testid="overseas-sites-count">{{ countText }}</p>
    <table class="govuk-table app-ors-table" data-testid="overseas-sites-table">
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header app-ors-table__site-column">{{ t('pages.manageOverseasSites.table.siteName') }}</th>
          <th scope="col" class="govuk-table__header app-ors-table__status-column">{{ t('pages.manageOverseasSites.table.status') }}</th>
          <th scope="col" class="govuk-table__header app-ors-table__actions-cell app-ors-table__actions-column">{{ t('pages.manageOverseasSites.table.actions') }}</th>
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        {% for site in sites %}
          <tr class="govuk-table__row" data-testid="site-row-{{ site.siteId }}">
            <td class="govuk-table__cell app-ors-table__site-cell">
              <div class="app-ors-table__site">
                <span data-testid="site-orsid-{{ site.siteId }}">{{ site.orsId }}</span>
                <div class="app-ors-table__details">
                  <strong class="govuk-!-font-weight-bold" data-testid="site-name-{{ site.siteId }}">{{ site.siteName }}</strong>
                  <span class="app-ors-table__address" data-testid="site-address-{{ site.siteId }}">{{ site.address }}</span>
                </div>
              </div>
              {% if site.interimSites.length %}
                {{ interimSiteDisclosure({
                  site: site,
                  readOnly: true,
                  labels: { interimDisclosure: t('pages.manageOverseasSites.interimDisclosure') }
                }) }}
              {% endif %}
            </td>
            <td class="govuk-table__cell">
              {% if site.isApproved %}
                <strong class="govuk-tag govuk-tag--green" data-testid="ors-status-tag-{{ site.siteId }}">{{ t('pages.manageOverseasSites.status.approved') }}</strong>
              {% else %}
                <strong class="govuk-tag govuk-tag--grey" data-testid="ors-status-tag-{{ site.siteId }}">{{ t('pages.manageOverseasSites.status.registered') }}</strong>
              {% endif %}
            </td>
            <td class="govuk-table__cell app-ors-table__actions-cell" data-testid="site-actions-{{ site.siteId }}">{{ siteActions(site) }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    {% if pagination %}
      {{ govukPagination(pagination) }}
    {% endif %}
  {% else %}
    <p class="govuk-body" data-testid="overseas-sites-empty">{{ t('pages.manageOverseasSites.empty') }}</p>
  {% endif %}

  <p class="govuk-body">
    <a href="{{ homeUrl }}" class="govuk-link" data-testid="return-to-home-link">{{ t('pages.manageOverseasSites.returnToHome') }}</a>
  </p>
{% endblock %}
