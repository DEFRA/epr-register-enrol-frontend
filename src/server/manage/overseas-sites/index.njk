{% extends 'layouts/page.njk' %}

{% from "govuk/components/tabs/macro.njk" import govukTabs %}
{% from "overseas-site-row/macro.njk" import interimSiteDisclosure %}

{# RA-492: where the ORS stands in the operator's in-year change requests. #}
{% macro siteActions(site) %}
  {% if site.pending %}
    <div class="app-ors-list__actions">
      <strong class="govuk-tag govuk-tag--yellow" data-testid="site-status-tag-{{ site.siteId }}">{{ t('pages.manageOverseasSites.status.pending') }}</strong>
    </div>
  {% elif site.inProgress %}
    <div class="app-ors-list__actions">
      <strong class="govuk-tag govuk-tag--blue govuk-!-margin-right-2" data-testid="site-status-tag-{{ site.siteId }}">{{ t('pages.manageOverseasSites.status.inProgress') }}</strong>
      {% if site.viewUrl %}<a class="govuk-link" href="{{ site.viewUrl }}" data-testid="view-request-{{ site.siteId }}">{{ t('pages.manageOverseasSites.viewChangeRequests') }}<span class="govuk-visually-hidden"> {{ site.siteName }}</span></a>{% endif %}
    </div>
  {% elif site.addUrl %}
    {# Adding a site changes the draft request, so this is a crumb-protected
       POST styled as a link. #}
    <form method="post" action="{{ site.addUrl }}" class="app-ors-list__actions">
      <input type="hidden" name="crumb" value="{{ crumb }}">
      <button type="submit" class="select-overseas-sites-link-button select-overseas-sites-link-button--blue govuk-body govuk-!-margin-bottom-0" data-testid="add-to-accreditation-{{ site.siteId }}">{{ t('pages.manageOverseasSites.addToAccreditation') }}<span class="govuk-visually-hidden"> {{ site.siteName }}</span></button>
    </form>
  {% endif %}
{% endmacro %}

{% macro orsList(name, sites) %}
  <h2 class="govuk-heading-m govuk-!-margin-bottom-2">{{ t('pages.manageOverseasSites.' + name + '.heading') }}</h2>
  {% if sites.length %}
    <p class="govuk-body app-ors-list__intro">{{ t('pages.manageOverseasSites.' + name + '.intro', { year: year }) }}</p>
    <ul class="govuk-list app-ors-list" data-testid="{{ name }}-sites-list">
      {% for site in sites %}
        <li class="app-ors-list__item" data-testid="{{ name }}-site-row-{{ site.siteId }}">
          <div class="app-ors-list__site">
            <span class="app-ors-list__number" data-testid="{{ name }}-site-orsid-{{ site.siteId }}">{{ site.orsId }}</span>
            <div class="app-ors-list__details">
              <strong class="govuk-!-font-weight-bold" data-testid="{{ name }}-site-name-{{ site.siteId }}">{{ site.siteName }}</strong>
              <span class="app-ors-list__address" data-testid="{{ name }}-site-address-{{ site.siteId }}">{{ site.address }}</span>
            </div>
            {{ siteActions(site) }}
          </div>
          {# Per Figma, the disclosure sits under the ORS number, not the name. #}
          {% if site.interimSites.length %}
            {{ interimSiteDisclosure({
              site: site,
              readOnly: true,
              labels: { interimDisclosure: t('pages.manageOverseasSites.interimDisclosure') }
            }) }}
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="govuk-body" data-testid="{{ name }}-sites-empty">{{ t('pages.manageOverseasSites.' + name + '.empty', { year: year }) }}</p>
  {% endif %}
{% endmacro %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {# RA-425: wider than two-thirds, so the title wraps after
         "reprocessing", as in Figma. #}
      <div class="app-ors-heading">
        <span class="govuk-caption-l" data-testid="page-caption">{{ caption }}</span>
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-6" data-testid="page-heading">{{ heading }}</h1>
      </div>
    </div>
  </div>

  {% if pendingCount > 0 %}
    <div class="govuk-notification-banner" role="region" aria-labelledby="pending-change-title" data-module="govuk-notification-banner" data-testid="pending-change-banner">
      <div class="govuk-notification-banner__header">
        <h2 class="govuk-notification-banner__title" id="pending-change-title">{{ t('pages.manageOverseasSites.pendingBanner.title') }}</h2>
      </div>
      <div class="govuk-notification-banner__content">
        <p class="govuk-body">{{ t('pages.manageOverseasSites.pendingBanner.body', { count: pendingCount }) }}</p>
      </div>
    </div>
  {% endif %}

  {% if readyForSubmissionCount > 0 %}
    <div class="govuk-notification-banner" role="region" aria-labelledby="requests-banner-title" data-module="govuk-notification-banner" data-testid="requests-banner">
      <div class="govuk-notification-banner__header">
        <h2 class="govuk-notification-banner__title" id="requests-banner-title">{{ t('pages.manageOverseasSites.requestsBanner.title') }}</h2>
      </div>
      <div class="govuk-notification-banner__content">
        <p class="govuk-body">
          {{ t('pages.manageOverseasSites.requestsBanner.body', { count: readyForSubmissionCount }) }}
          {% if requestsUrl %}<br><a class="govuk-notification-banner__link" href="{{ requestsUrl }}" data-testid="view-requests-link">{{ t('pages.manageOverseasSites.requestsBanner.link') }}</a>{% endif %}
        </p>
      </div>
    </div>
  {% endif %}

  {{ govukTabs({
    classes: 'app-ors-tabs',
    attributes: { 'data-testid': 'overseas-sites-tabs' },
    items: [
      {
        label: t('pages.manageOverseasSites.accredited.tab', { count: accreditedSites.length }),
        id: 'accredited',
        attributes: { 'data-testid': 'accredited-sites-tab' },
        panel: {
          html: orsList('accredited', accreditedSites),
          attributes: { 'data-testid': 'accredited-sites-panel' }
        }
      },
      {
        label: t('pages.manageOverseasSites.registered.tab', { count: registeredSites.length }),
        id: 'registered',
        attributes: { 'data-testid': 'registered-sites-tab' },
        panel: {
          html: orsList('registered', registeredSites),
          attributes: { 'data-testid': 'registered-sites-panel' }
        }
      }
    ]
  }) }}

  <p class="govuk-body">
    <a href="{{ homeUrl }}" class="govuk-link" data-testid="return-to-home-link">{{ t('pages.manageOverseasSites.returnToHome') }}</a>
  </p>
{% endblock %}
