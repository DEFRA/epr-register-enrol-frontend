{% extends 'layouts/page.njk' %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% if notification %}
        {{ govukNotificationBanner({ text: notification }) }}
      {% endif %}

      {% if error %}
        <div class="govuk-error-summary" data-module="govuk-error-summary" role="alert">
          <h2 class="govuk-error-summary__title">{{ t('pages.operatorAccreditation.seedErrorHeading') }}</h2>
          <div class="govuk-error-summary__body">
            <p class="govuk-body" data-testid="error-message">{{ error }}</p>
          </div>
        </div>
      {% else %}
        <h1 class="govuk-heading-l" data-testid="page-heading">{{ pageHeading }}</h1>

        {% if displayReapplyAccreditationText %}
          <div class="govuk-inset-text">
            <p class="govuk-body">You can now reapply for accreditation for this material.</p>
            <p class="govuk-body">Submit the application by 30 September 2026 to get accreditation approval from 1 January 2027.</p>
          </div>
        {% endif %}

        <h2 class="govuk-heading-m">{{ t('pages.operatorAccreditation.applicationDetailsHeading') }}</h2>
        <table class="govuk-table" data-testid="application-details-table">
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th scope="col" class="govuk-table__header">{{ t('pages.operatorAccreditation.periodLabel') }}</th>
              <th scope="col" class="govuk-table__header">{{ t('pages.operatorAccreditation.dueDateLabel') }}</th>
              <th scope="col" class="govuk-table__header">{{ t('pages.operatorAccreditation.statusLabel') }}</th>
              <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">{{ t('pages.operatorAccreditation.continueButton') }}</span></th>
              <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">{{ t('pages.operatorAccreditation.withdrawLink') }}</span></th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            <tr class="govuk-table__row" data-testid="application-details-row">
              <td class="govuk-table__cell" data-testid="application-period">{{ accreditationYear }}</td>
              <td class="govuk-table__cell" data-testid="application-due-date">{{ dueDate }}</td>
              <td class="govuk-table__cell" data-testid="application-status">
                <strong class="govuk-tag {{ statusTagClass }}" data-testid="status-tag">
                  {{ statusLabel }}
                </strong>
              </td>
              <td class="govuk-table__cell">
                {% if showContinueLink %}
                  <a href="{{ taskListUrl }}" data-testid="continue-button">
                    {{ t('pages.operatorAccreditation.continueButton') }}
                  </a>
                {% endif %}
              </td>
              <td class="govuk-table__cell">
                {% if canWithdraw %}
                  <a href="{{ withdrawUrl }}" data-testid="withdraw-link">
                    {{ t('pages.operatorAccreditation.withdrawLink') }}
                  </a>
                {% endif %}
                {% if startNewUrl %}
                  {# RA-357: this creates an application, so it is a crumb-protected
                     POST rather than an anchor — see operator-accreditation/controller.js. #}
                  <form method="post" action="{{ startNewUrl }}" data-testid="start-new-form">
                    <input type="hidden" name="crumb" value="{{ crumb }}">
                    <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" data-testid="start-new-link">
                      {{ t('pages.operatorAccreditation.startNew') }}
                    </button>
                  </form>
                {% endif %}
              </td>
            </tr>
          </tbody>
        </table>

        {% if currentAccreditation %}
          <h2 class="govuk-heading-m">{{ t('pages.operatorAccreditation.currentAccreditationHeading') }}</h2>
          <dl class="govuk-summary-list govuk-!-margin-bottom-6" data-testid="current-accreditation-summary">
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">{{ t('pages.operatorAccreditation.accreditationNumberLabel') }}</dt>
              <dd class="govuk-summary-list__value" data-testid="current-accreditation-number">{{ currentAccreditation.accreditationNumber }}</dd>
            </div>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Registration Number </dt>
              <dd class="govuk-summary-list__value" data-testid="registration-number">{{ registrationId }}</dd>
            </div>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">{{ t('pages.operatorAccreditation.regulatorLabel') }}</dt>
              <dd class="govuk-summary-list__value" data-testid="current-accreditation-regulator">{{ currentAccreditation.regulator }}</dd>
            </div>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">{{ t('pages.operatorAccreditation.statusLabel') }}</dt>
              <dd class="govuk-summary-list__value" data-testid="current-accreditation-status">
                <strong class="govuk-tag {{ currentAccreditation.statusTagClass }}" data-testid="current-accreditation-status-tag">
                  {{ currentAccreditation.status }}
                </strong>
              </dd>
            </div>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">{{ t('pages.operatorAccreditation.expiryDateLabel') }}</dt>
              <dd class="govuk-summary-list__value" data-testid="current-accreditation-expiry-date">{{ currentAccreditation.expiryDate }}</dd>
            </div>
            {% if not isExporter %}
              <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">{{ t('pages.operatorAccreditation.siteAddressLabel') }}</dt>
                <dd class="govuk-summary-list__value" data-testid="current-accreditation-site-address">{{ currentAccreditation.siteAddress }}</dd>
              </div>
            {% endif %}
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">{{ t('pages.operatorAccreditation.tonnageLabel') }}</dt>
              <dd class="govuk-summary-list__value" data-testid="current-accreditation-tonnage">{{ currentAccreditation.tonnage }}</dd>
            </div>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">{{ t('pages.operatorAccreditation.authorisedUsersLabel') }}</dt>
              <dd class="govuk-summary-list__value" data-testid="current-accreditation-authorised-users">
                {% for authorisedUser in currentAccreditation.authorisedUsers %}
                  {{ authorisedUser }}<br>
                {% endfor %}
              </dd>
            </div>
            {% if currentAccreditation.overseasSites.length > 0 %}
              <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">{{ t('pages.operatorAccreditation.overseasSitesLabel') }}</dt>
                <dd class="govuk-summary-list__value" data-testid="current-accreditation-overseas-sites">
                  {% for overseasSite in currentAccreditation.overseasSites %}
                    {{ overseasSite }}<br>
                  {% endfor %}
                </dd>
              </div>
            {% endif %}
          </dl>
        {% endif %}

        <dl class="govuk-summary-list govuk-!-margin-bottom-6" data-testid="application-summary">
          {% if notificationFailedBanner %}
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">{{ t('pages.operatorAccreditation.notificationStatusLabel') }}</dt>
              <dd class="govuk-summary-list__value" data-testid="notification-status">
                <strong class="govuk-tag govuk-tag--red" data-testid="notification-status-tag">
                  {{ t('pages.operatorAccreditation.notificationFailedLabel') }}
                </strong>
              </dd>
            </div>
          {% endif %}
        </dl>
      {% endif %}

    </div>
  </div>
{% endblock %}
