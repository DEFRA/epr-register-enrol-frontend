{% extends 'layouts/page.njk' %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  {{ appHeading({ text: pageTitle }) }}
  <div data-testid="granted-accreditation-summary">
    {{ govukSummaryList({ rows: [
      { key: { text: t('pages.grantedAccreditation.organisation') }, value: { text: target.organisationName } },
      { key: { text: t('pages.grantedAccreditation.organisationId') }, value: { text: target.organisationId } },
      { key: { text: t('pages.grantedAccreditation.registration') }, value: { text: target.registrationReference } },
      { key: { text: t('pages.grantedAccreditation.registrationId') }, value: { text: target.registrationId } },
      { key: { text: t('pages.grantedAccreditation.accreditation') }, value: { text: target.accreditationId } },
      { key: { text: t('pages.grantedAccreditation.material') }, value: { text: t('pages.operatorAccreditation.materials.' + target.materialType) } },
      { key: { text: t('pages.grantedAccreditation.year') }, value: { text: target.year } },
      { key: { text: t('pages.grantedAccreditation.status') }, value: { html: govukTag({ text: t('pages.grantedAccreditation.granted'), classes: 'govuk-tag--green', attributes: { 'data-testid': 'granted-status' } }) } }
    ] }) }}
  </div>
  {% if proposal %}
    <h2 class="govuk-heading-m">{{ t('pages.grantedAccreditation.proposedSite') }}</h2>
    <div data-testid="prepared-ors-proposal">
      {{ govukSummaryList({ rows: [
        { key: { text: t('pages.grantedAccreditation.siteName') }, value: { text: target.proposal.siteName } },
        { key: { text: t('pages.grantedAccreditation.address') }, value: { text: target.proposal.siteAddress } },
        { key: { text: t('pages.grantedAccreditation.country') }, value: { text: target.proposal.country } }
      ] }) }}
    </div>
    {% if not target.activeRequest %}
      <form method="post" action="{{ submitUrl }}" data-testid="ors-submission-form">
        <input type="hidden" name="crumb" value="{{ crumb }}">
        {{ govukButton({ text: t('pages.grantedAccreditation.submitExample'), attributes: { 'data-testid': 'submit-ors-example' } }) }}
      </form>
    {% endif %}
  {% else %}
    <h2 class="govuk-heading-m">{{ t('pages.grantedAccreditation.approvedSites') }}</h2>
    <ul class="govuk-list govuk-list--bullet" data-testid="approved-sites">
      {% for site in target.overseasSites %}
        <li>{{ site.siteName }} — {{ site.siteAddress }}, {{ site.country }}</li>
      {% endfor %}
      {% for site in target.approvedAdditions %}
        <li data-testid="approved-ors-addition" data-site-id="{{ site.siteId }}" data-request-id="{{ site.requestId }}">{{ site.siteName }} — {{ site.siteAddress }}, {{ site.country }}</li>
      {% endfor %}
    </ul>
    {% if not target.activeRequest %}
      <p class="govuk-body"><a class="govuk-link" href="{{ changeUrl }}" data-testid="accreditation-change">{{ t('pages.grantedAccreditation.change') }}</a></p>
    {% endif %}
  {% endif %}
  {% if target.activeRequest %}
    <section data-testid="active-change-request" data-request-id="{{ target.activeRequest.requestId }}" data-case-id="{{ target.activeRequest.caseId }}" data-site-id="{{ target.activeRequest.proposedSiteId }}">
      <h2 class="govuk-heading-m">{{ t('pages.grantedAccreditation.activeRequest') }}</h2>
      {{ govukSummaryList({ rows: [
        { key: { text: t('pages.grantedAccreditation.requestId') }, value: { text: target.activeRequest.requestId } },
        { key: { text: t('pages.grantedAccreditation.requestStatus') }, value: { text: t('pages.grantedAccreditation.requestStates.' + requestStatusKey) } },
        { key: { text: t('pages.grantedAccreditation.caseReference') }, value: { text: target.activeRequest.caseReference or t('pages.grantedAccreditation.awaitingReceipt') } },
        { key: { text: t('pages.grantedAccreditation.caseId') }, value: { text: target.activeRequest.caseId or t('pages.grantedAccreditation.awaitingReceipt') } },
        { key: { text: t('pages.grantedAccreditation.caseState') }, value: { text: t('pages.grantedAccreditation.caseStates.' + caseStateKey) } }
      ] }) }}
      {% if target.activeRequest.caseState === 'rejected' or target.activeRequest.caseState === 'approved' %}
        <p class="govuk-body" data-testid="ors-outcome-unconfirmed">{{ t('pages.grantedAccreditation.outcomeUnconfirmed') }}</p>
      {% endif %}
      {% if target.activeRequest.status === 'submission-pending' %}
        <p class="govuk-body">{{ t('pages.grantedAccreditation.unconfirmed') }}</p>
        <form method="post" action="{{ submitUrl }}">
          <input type="hidden" name="crumb" value="{{ crumb }}">
          {{ govukButton({ text: t('pages.grantedAccreditation.retrySubmission'), attributes: { 'data-testid': 'retry-ors-submission' } }) }}
        </form>
      {% endif %}
    </section>
  {% endif %}
  {% if target.history.length %}
    <section data-testid="change-request-history">
      <h2 class="govuk-heading-m">{{ t('pages.grantedAccreditation.history') }}</h2>
      {% for attempt in target.history %}
        <div data-testid="closed-change-request" data-request-id="{{ attempt.requestId }}" data-case-id="{{ attempt.caseId }}" data-site-id="{{ attempt.proposedSiteId }}">
          {{ govukSummaryList({ rows: [
            { key: { text: t('pages.grantedAccreditation.requestId') }, value: { text: attempt.requestId } },
            { key: { text: t('pages.grantedAccreditation.requestStatus') }, value: { text: t('pages.grantedAccreditation.requestStates.' + attempt.status) } },
            { key: { text: t('pages.grantedAccreditation.caseReference') }, value: { text: attempt.caseReference } },
            { key: { text: t('pages.grantedAccreditation.caseId') }, value: { text: attempt.caseId } }
          ] }) }}
        </div>
      {% endfor %}
    </section>
  {% endif %}
{% endblock %}
