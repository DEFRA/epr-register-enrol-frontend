{% extends "layouts/page.njk" %}
{% from "govuk/components/character-count/macro.njk" import govukCharacterCount %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% if error %}
        <div class="govuk-error-summary" data-module="govuk-error-summary" role="alert" data-testid="error-summary">
          <h2 class="govuk-error-summary__title">{{ t('common.errorSummaryTitle') }}</h2>
          <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
              <li><a href="#repatriated-loads">{{ error }}</a></li>
            </ul>
          </div>
        </div>
      {% endif %}

      <span class="govuk-caption-l" data-testid="page-caption">{{ applicationHeader.captionText }}</span>
      <h1 class="govuk-heading-l" data-testid="page-heading">{{ heading }}</h1>

      <form method="post">
        <input type="hidden" name="crumb" value="{{ crumb }}">

        {# RA-361: govukCharacterCount progressively enhances this into a live
           "words remaining"/"words too many" counter (GOV.UK Frontend's own
           character-count.js, already loaded in application.js and already
           used the same way by withdraw-application's reason field and
           business-plan-detail) that updates, and clears itself, on every
           keystroke — before the operator ever submits. countWords in
           controller.js is still the real gate. textareaInput carries every
           macro param, built in controller.js#buildTextareaInput. #}
        {{ govukCharacterCount(textareaInput) }}

        <button type="submit" class="govuk-button" data-module="govuk-button"
                data-testid="continue-button">
          {{ continueButton }}
        </button>
      </form>

      <a href="{{ cancelUrl }}" class="govuk-link" data-testid="cancel-link">{{ cancelLink }}</a>

    </div>
  </div>
{% endblock %}
