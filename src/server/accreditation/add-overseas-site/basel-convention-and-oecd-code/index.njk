{% extends "layouts/page.njk" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <a href="{{ backLink }}" class="govuk-back-link" data-testid="back-link">{{ t('common.back') }}</a>

      {% if errors and errors | length > 0 %}
        <div class="govuk-error-summary" data-module="govuk-error-summary" role="alert" data-testid="error-summary">
          <h2 class="govuk-error-summary__title">{{ t('common.errorSummaryTitle') }}</h2>
          <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
              {% for code in codes %}
                {% if code.error %}<li><a href="#basel-code-{{ code.index + 1 }}">{{ code.error }}</a></li>{% endif %}
              {% endfor %}
            </ul>
          </div>
        </div>
      {% endif %}

      {% if siteName or siteAddress %}
        <span class="govuk-caption-l" data-testid="site-summary">{{ siteName }}{% if siteAddress %}, {{ siteAddress }}{% endif %}</span>
      {% endif %}

      <h1 class="govuk-heading-l" data-testid="page-heading">{{ heading }}</h1>
      <div class="govuk-hint">{{ hint }}</div>

      <p class="govuk-body">
        <a class="govuk-link" href="{{ guidanceLinkUrl }}" target="_blank" rel="noreferrer noopener" data-testid="guidance-link">
          {{ guidanceLinkText }}<span class="govuk-visually-hidden"> {{ t('common.opensInNewTab') }}</span>
        </a>
      </p>

      <form method="post">
        <input type="hidden" name="crumb" value="{{ crumb }}">
        <input type="hidden" name="visibleCount" value="{{ visibleCount }}">

        {% for code in codes %}
          <div class="govuk-form-group{% if code.error %} govuk-form-group--error{% endif %}">
            <label class="govuk-label" for="basel-code-{{ code.index + 1 }}">{{ codeLabel }} {{ code.index + 1 }}</label>
            {% if code.error %}
              <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> {{ code.error }}</p>
            {% endif %}
            <div class="govuk-input__wrapper">
              <input class="govuk-input govuk-input--width-10{% if code.error %} govuk-input--error{% endif %}"
                     id="basel-code-{{ code.index + 1 }}" name="code-{{ code.index }}" type="text"
                     value="{{ code.value }}"
                     data-testid="basel-code-{{ code.index + 1 }}-input">
              {% if canRemove %}
                <button type="submit" name="action" value="removeCode-{{ code.index }}"
                        class="govuk-button govuk-button--secondary govuk-!-margin-left-2"
                        data-testid="remove-code-{{ code.index + 1 }}-button">
                  {{ removeCodeButtonLabel }}
                </button>
              {% endif %}
            </div>
          </div>
        {% endfor %}

        {% if canAddMore %}
          <button type="submit" name="action" value="addCode"
                  class="govuk-button govuk-button--secondary"
                  data-testid="add-code-button">
            {{ addCodeButtonLabel }}
          </button>
        {% endif %}

        <div class="govuk-button-group">
          <button type="submit" name="action" value="continue" class="govuk-button" data-module="govuk-button"
                  data-testid="continue-button">
            {{ continueButton }}
          </button>
        </div>
      </form>

      <a href="{{ cancelUrl }}" class="govuk-link" data-testid="cancel-link">{{ cancelLink }}</a>

    </div>
  </div>
{% endblock %}
