{% extends 'layouts/page.njk' %}
{% from "govuk/components/character-count/macro.njk" import govukCharacterCount %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "error-summary/macro.njk" import appErrorSummary %}

{# RA-682 AC02: locked fields are read-only inputs with no name, so they are never posted. #}
{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ appErrorSummary(errors, t('common.errorSummaryTitle')) }}

      <span class="govuk-caption-l" data-testid="page-caption">{{ applicationHeader.captionText }}</span>
      <h1 class="govuk-heading-l" data-testid="page-heading">{{ heading }}</h1>

      <form method="post" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}">
        {% for input in inputs %}
          {% if input.characterCount %}
            {{ govukCharacterCount(input.characterCount) }}
          {% else %}
            {{ govukInput({
              id: input.name,
              name: input.name,
              type: input.type or 'text',
              value: input.value,
              classes: input.width,
              label: { text: input.label },
              hint: { text: input.hint } if input.hint else undefined,
              errorMessage: {
                text: input.error,
                visuallyHiddenText: t('common.error'),
                attributes: { 'data-testid': input.name + '-error' }
              } if input.error else undefined,
              attributes: { 'data-testid': input.name + '-input' }
            }) }}
          {% endif %}
        {% endfor %}

        {% for field in readOnly %}
          {{ govukInput({
            id: field.name,
            value: field.value,
            classes: 'app-input--readonly',
            label: { text: field.label },
            hint: { text: field.hint } if field.hint else undefined,
            attributes: { readonly: 'readonly', 'data-testid': field.name + '-input' }
          }) }}
        {% endfor %}

        <button type="submit" class="govuk-button" data-module="govuk-button" data-prevent-double-click="true" data-testid="continue-button">{{ t('common.continue') }}</button>
      </form>
      <a href="{{ cancelUrl }}" class="govuk-link" data-testid="cancel-link">{{ t('pages.manageOverseasSites.cancel') }}</a>
    </div>
  </div>
{% endblock %}
