{% extends 'layouts/page.njk' %}

{#
  RA-682: one step changing an accredited ORS's details. Locked fields (AC02)
  are shown as read-only inputs (user, 2026-11-26).
#}
{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errors.length %}
        <div class="govuk-error-summary" data-module="govuk-error-summary" data-testid="error-summary">
          <div role="alert">
            <h2 class="govuk-error-summary__title">{{ t('common.errorSummaryTitle') }}</h2>
            <div class="govuk-error-summary__body">
              <ul class="govuk-list govuk-error-summary__list">
                {% for error in errors %}
                  <li><a href="{{ error.href }}">{{ error.text }}</a></li>
                {% endfor %}
              </ul>
            </div>
          </div>
        </div>
      {% endif %}

      <span class="govuk-caption-l" data-testid="page-caption">{{ applicationHeader.captionText }}</span>
      <h1 class="govuk-heading-l" data-testid="page-heading">{{ heading }}</h1>

      <form method="post" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}">
        {% for input in inputs %}
          <div class="govuk-form-group{% if input.error %} govuk-form-group--error{% endif %}">
            <label class="govuk-label" for="{{ input.name }}">{{ input.label }}</label>
            {% if input.hint %}<div class="govuk-hint" id="{{ input.name }}-hint">{{ input.hint }}</div>{% endif %}
            {% if input.error %}
              <p class="govuk-error-message" data-testid="{{ input.name }}-error"><span class="govuk-visually-hidden">{{ t('common.error') }}:</span> {{ input.error }}</p>
            {% endif %}
            {% if input.type == 'textarea' %}
              <textarea class="govuk-textarea{% if input.error %} govuk-textarea--error{% endif %}" id="{{ input.name }}" name="{{ input.name }}" rows="6" data-testid="{{ input.name }}-input">{{ input.value }}</textarea>
            {% else %}
              <input class="govuk-input {{ input.width }}{% if input.error %} govuk-input--error{% endif %}" id="{{ input.name }}" name="{{ input.name }}" type="{{ input.type or 'text' }}" value="{{ input.value }}" data-testid="{{ input.name }}-input">
            {% endif %}
          </div>
        {% endfor %}

        {% for field in readOnly %}
          <div class="govuk-form-group">
            <label class="govuk-label" for="{{ field.name }}">{{ field.label }}</label>
            {% if field.hint %}<div class="govuk-hint" id="{{ field.name }}-hint">{{ field.hint }}</div>{% endif %}
            <input class="govuk-input app-input--readonly" id="{{ field.name }}" name="{{ field.name }}" type="text" value="{{ field.value }}" readonly data-testid="{{ field.name }}-input">
          </div>
        {% endfor %}

        <button type="submit" class="govuk-button" data-module="govuk-button" data-testid="continue-button">{{ t('common.continue') }}</button>
      </form>
      <a href="{{ cancelUrl }}" class="govuk-link" data-testid="cancel-link">{{ t('pages.manageOverseasSites.cancel') }}</a>
    </div>
  </div>
{% endblock %}
