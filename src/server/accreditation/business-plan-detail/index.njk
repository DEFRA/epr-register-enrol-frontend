{% extends "layouts/page.njk" %}
{% from "govuk/components/character-count/macro.njk" import govukCharacterCount %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% if error %}
        <div class="govuk-error-summary" data-module="govuk-error-summary" role="alert" data-testid="error-summary">
          <h2 class="govuk-error-summary__title">{{ t('common.errorSummaryTitle') }}</h2>
          <div class="govuk-error-summary__body">
            <p>{{ error }}</p>
          </div>
        </div>
      {% endif %}

      {% if errors and (errors | length > 0) %}
        <div class="govuk-error-summary" data-module="govuk-error-summary" role="alert" data-testid="error-summary">
          <h2 class="govuk-error-summary__title">{{ t('common.errorSummaryTitle') }}</h2>
          <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
              {% for input in textareaInputs %}
                {% if input.errorMessage %}
                  <li><a href="#{{ input.id }}">{{ input.errorMessage.text }}</a></li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
        </div>
      {% endif %}

      <span class="govuk-caption-l" data-testid="page-caption">{{ applicationHeader.captionText }}</span>
      <h1 class="govuk-heading-l" data-testid="page-heading">{{ heading }}</h1>

      <p class="govuk-body" data-testid="intro-text">{{ intro }}</p>

      {% if readOnly %}
        <div class="govuk-inset-text" data-testid="read-only-notice">
          {% if isQueriedApplication %}
            <p class="govuk-body">
              <strong>{{ t('common.readOnlySection.heading') }}</strong><br>
              {{ t('common.readOnlySection.body') }}
            </p>
          {% else %}
            <p class="govuk-body">
              <strong>{{ t('common.readOnlySubmittedSection.heading') }}</strong><br>
              {{ t('common.readOnlySubmittedSection.body') }}
            </p>
          {% endif %}
        </div>
      {% endif %}

      <form method="post" novalidate>
        <input type="hidden" name="crumb" value="{{ crumb }}">

        {# RA-268: govukCharacterCount progressively enhances this into a live
           "characters remaining"/"characters too many" counter (GOV.UK
           Frontend's own character-count.js, already loaded in
           application.js and already used the same way by
           withdraw-application's reason field) that updates, and clears
           itself, on every keystroke — before the operator ever submits.
           validateDetailFields on the server is still the real gate; this is
           the same 500-character rule surfaced earlier. textareaInputs
           already carries every macro param (id/name/value/label/hint/
           maxlength/errorMessage/attributes/formGroup) built in
           controller.js#buildTextareaInputs. #}
        {% for textarea in textareaInputs %}
          {{ govukCharacterCount(textarea) }}
        {% endfor %}

        {% if not readOnly %}
          <button type="submit" name="submitAction" value="saveAndContinue" class="govuk-button" data-module="govuk-button" data-testid="continue-button">
            {{ t('pages.businessPlanDetail.saveAndContinue') }}
          </button>

          <button type="submit" name="submitAction" value="saveAndComeLater" class="govuk-button govuk-button--secondary" data-module="govuk-button" data-testid="save-come-back-button">
            {{ t('pages.businessPlanDetail.saveAndComeLater') }}
          </button>
        {% endif %}

      </form>

    </div>
  </div>
{% endblock %}
