{% extends "layouts/page.njk" %}
{% from "govuk/components/file-upload/macro.njk" import govukFileUpload %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {{ regulatorQueryBanner({
        queryNote: queryNote,
        heading: t('common.regulatorQuery.heading'),
        summary: querySummary,
        updateHeading: t('common.regulatorQuery.updateHeading'),
        changeLinkText: t('common.regulatorQuery.changeLink'),
        fields: regulatorQueryFields
      }) }}

      {% if error %}
        <div class="govuk-error-summary" data-module="govuk-error-summary" data-testid="error-summary">
          <div role="alert">
            <h2 class="govuk-error-summary__title">{{ t('common.errorSummaryTitle') }}</h2>
            <div class="govuk-error-summary__body">
              <p>{{ error }}</p>
            </div>
          </div>
        </div>
      {% endif %}

      <h1 class="govuk-heading-l" data-testid="page-heading">{{ heading }}</h1>
      <p class="govuk-body">
        {{ t('pages.samplingPlanUpload.youNeedToUploadAPlan') }}
        <a class="govuk-link" href="https://www.gov.uk/government/publications/extended-producer-responsibility-for-packaging-templates-for-sampling-and-inspection-plans" data-testid="guidance-link">{{ t('pages.samplingPlanUpload.planLinkText') }}</a>.
      </p>

      <form method="post" enctype="multipart/form-data" novalidate data-testid="upload-form"
            data-error-too-large="{{ t('pages.samplingPlanUpload.validation.fileTooLarge') }}"
            data-error-invalid-type="{{ t('pages.samplingPlanUpload.validation.invalidType') }}"
            data-error-no-document-type="{{ t('pages.samplingPlanUpload.validation.noDocumentType') }}">
        <input type="hidden" name="crumb" value="{{ crumb }}">

        {{ govukFileUpload({
          id: "file",
          name: "file",
          label: {
            text: t('pages.samplingPlanUpload.uploadAFile'),
            classes: "govuk-label--m"
          },
          hint: {
            text: t('pages.samplingPlanUpload.fileRequriements')
          },
          errorMessage: {
            text: fileError,
            visuallyHiddenText: t('common.error'),
            attributes: { "data-testid": "file-error" }
          } if fileError else false,
          javascript: true,
          chooseFilesButtonText: t('pages.samplingPlanUpload.chooseFile'),
          dropInstructionText: t('pages.samplingPlanUpload.orDropFile'),
          noFileChosenText: t('pages.samplingPlanUpload.noFileChosen'),
          attributes: {
            accept: ".pdf,.doc,.docx,.xls,.csv,.png,.tif,.jpg,.msg",
            "data-testid": "file-input"
          }
        }) }}

        <div class="govuk-form-group{% if documentTypeError %} govuk-form-group--error{% endif %}">
          <label class="govuk-label" for="document-type">
            {{ t('pages.samplingPlanUpload.documentTypeLabel') }}
          </label>
          {% if documentTypeError %}
            <p id="document-type-error" class="govuk-error-message" data-testid="document-type-error">
              <span class="govuk-visually-hidden">{{ t('common.error') }}:</span> {{ documentTypeError }}
            </p>
          {% endif %}
          <select class="govuk-select{% if documentTypeError %} govuk-select--error{% endif %}"
                  id="document-type"
                  name="documentType"
                  {% if documentTypeError %}aria-describedby="document-type-error"{% endif %}
                  data-testid="document-type-input">
            <option value="">{{ t('pages.samplingPlanUpload.documentTypeDefault') }}</option>
            {% for option in documentTypeOptions %}
              <option value="{{ option.value }}"{% if option.value == fields.documentType %} selected{% endif %}>{{ option.label }}</option>
            {% endfor %}
          </select>
        </div>

        <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button" data-testid="upload-button">
          {{ t('pages.samplingPlanUpload.uploadButton') }}
        </button>
      </form>

      {% if viewableFilesCount and viewableFilesCount > 0 %}
        <p class="govuk-body" data-testid="view-uploaded-files">
          <a class="govuk-link" href="{{ resultsLink }}" data-testid="view-uploaded-files-link">
            {{ t('pages.samplingPlanUpload.viewUploadedFiles').replace('{count}', viewableFilesCount) }}
          </a>
        </p>
      {% endif %}

      <form method="post" action="{{ resultsLink }}" novalidate data-testid="continue-form">
        <input type="hidden" name="crumb" value="{{ crumb }}">
        <button type="submit" name="action" value="saveAndContinue" class="govuk-button" data-module="govuk-button" data-testid="save-continue-button">
          {{ t('pages.samplingPlanUpload.saveAndContinue') }}
        </button>
        <button type="submit" name="action" value="saveAndComeLater" class="govuk-button govuk-button--secondary" data-module="govuk-button" data-testid="save-come-back-button">
          {{ t('pages.samplingPlanUpload.saveAndComeLater') }}
        </button>
      </form>

    </div>
  </div>
{% endblock %}
