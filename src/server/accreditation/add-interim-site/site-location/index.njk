{% extends "layouts/page.njk" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% if errors and (errors.addressLine1 or errors.addressLine2 or errors.townOrCity or errors.stateOrRegion or errors.postcode) %}
        <div class="govuk-error-summary" data-module="govuk-error-summary" role="alert" data-testid="error-summary">
          <h2 class="govuk-error-summary__title">{{ t('common.errorSummaryTitle') }}</h2>
          <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
              {% if errors.addressLine1 %}<li><a href="#address-line1">{{ errors.addressLine1 }}</a></li>{% endif %}
              {% if errors.addressLine2 %}<li><a href="#address-line2">{{ errors.addressLine2 }}</a></li>{% endif %}
              {% if errors.townOrCity %}<li><a href="#town-or-city">{{ errors.townOrCity }}</a></li>{% endif %}
              {% if errors.stateOrRegion %}<li><a href="#state-or-region">{{ errors.stateOrRegion }}</a></li>{% endif %}
              {% if errors.postcode %}<li><a href="#postcode">{{ errors.postcode }}</a></li>{% endif %}
            </ul>
          </div>
        </div>
      {% endif %}

      <span class="govuk-caption-l" data-testid="page-caption">{{ applicationHeader.captionText }}</span>
      <h1 class="govuk-heading-l" data-testid="page-heading">{{ heading }}</h1>

      <form method="post">
        <input type="hidden" name="crumb" value="{{ crumb }}">

        <div class="govuk-form-group{% if errors.addressLine1 %} govuk-form-group--error{% endif %}">
          <label class="govuk-label" for="address-line1">{{ t('pages.addInterimSite.siteLocation.addressLine1Label') }}</label>
          {% if errors.addressLine1 %}
            <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> {{ errors.addressLine1 }}</p>
          {% endif %}
          <input class="govuk-input{% if errors.addressLine1 %} govuk-input--error{% endif %}"
                 id="address-line1" name="addressLine1" type="text"
                 value="{{ fields.addressLine1 }}"
                 autocomplete="address-line1"
                 data-testid="address-line1-input">
        </div>

        <div class="govuk-form-group{% if errors.addressLine2 %} govuk-form-group--error{% endif %}">
          <label class="govuk-label" for="address-line2">{{ t('pages.addInterimSite.siteLocation.addressLine2Label') }}</label>
          {% if errors.addressLine2 %}
            <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> {{ errors.addressLine2 }}</p>
          {% endif %}
          <input class="govuk-input{% if errors.addressLine2 %} govuk-input--error{% endif %}" id="address-line2" name="addressLine2" type="text"
                 value="{{ fields.addressLine2 }}"
                 autocomplete="address-line2"
                 data-testid="address-line2-input">
        </div>

        <div class="govuk-form-group{% if errors.townOrCity %} govuk-form-group--error{% endif %}">
          <label class="govuk-label" for="town-or-city">{{ t('pages.addInterimSite.siteLocation.townOrCityLabel') }}</label>
          {% if errors.townOrCity %}
            <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> {{ errors.townOrCity }}</p>
          {% endif %}
          <input class="govuk-input govuk-input--width-20{% if errors.townOrCity %} govuk-input--error{% endif %}"
                 id="town-or-city" name="townOrCity" type="text"
                 value="{{ fields.townOrCity }}"
                 data-testid="town-or-city-input">
        </div>

        <div class="govuk-form-group{% if errors.stateOrRegion %} govuk-form-group--error{% endif %}">
          <label class="govuk-label" for="state-or-region">{{ t('pages.addInterimSite.siteLocation.stateOrRegionLabel') }}</label>
          {% if errors.stateOrRegion %}
            <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> {{ errors.stateOrRegion }}</p>
          {% endif %}
          <input class="govuk-input govuk-input--width-20{% if errors.stateOrRegion %} govuk-input--error{% endif %}" id="state-or-region" name="stateOrRegion" type="text"
                 value="{{ fields.stateOrRegion }}"
                 data-testid="state-or-region-input">
        </div>

        <div class="govuk-form-group{% if errors.postcode %} govuk-form-group--error{% endif %}">
          <label class="govuk-label" for="postcode">{{ t('pages.addInterimSite.siteLocation.postcodeLabel') }}</label>
          {% if errors.postcode %}
            <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> {{ errors.postcode }}</p>
          {% endif %}
          <input class="govuk-input govuk-input--width-10{% if errors.postcode %} govuk-input--error{% endif %}" id="postcode" name="postcode" type="text"
                 value="{{ fields.postcode }}"
                 data-testid="postcode-input">
        </div>

        <button type="submit" class="govuk-button" data-module="govuk-button"
                data-testid="continue-button">
          {{ continueButton }}
        </button>
      </form>

      <a href="{{ cancelUrl }}" class="govuk-link" data-testid="cancel-link">{{ cancelLink }}</a>

    </div>
  </div>
{% endblock %}
