{% extends "layouts/page.njk" %}
{% from "overseas-site-row/macro.njk" import overseasSiteRows %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

      {{ regulatorQueryBanner({
        queried: queried,
        heading: t('common.regulatorQuery.heading'),
        summary: querySummary,
        updateHeading: t('common.regulatorQuery.updateHeading'),
        changeLinkText: t('common.regulatorQuery.changeLink'),
        fields: regulatorQueryFields
      }) }}

      {% if successBanner %}
        <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
             aria-labelledby="govuk-notification-banner-title"
             data-module="govuk-notification-banner"
             data-testid="ors-success-banner">
          <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">
              {{ t('pages.addOverseasSite.successBanner.title') }}
            </h2>
          </div>
          <div class="govuk-notification-banner__content">
            <p class="govuk-body">{{ t('pages.addOverseasSite.successBanner.heading') }}</p>
          </div>
        </div>
      {% endif %}

      {% if interimSiteSuccessBanner %}
        <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
             aria-labelledby="govuk-interim-site-notification-banner-title"
             data-module="govuk-notification-banner"
             data-testid="interim-site-success-banner">
          <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-interim-site-notification-banner-title">
              {{ t('pages.addInterimSite.successBanner.title') }}
            </h2>
          </div>
          <div class="govuk-notification-banner__content">
            <p class="govuk-body">{{ t('pages.addInterimSite.successBanner.heading') }}</p>
          </div>
        </div>
      {% endif %}

      {% if promoteSuccessBanner %}
        <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
             aria-labelledby="govuk-promote-notification-banner-title"
             data-module="govuk-notification-banner"
             data-testid="ors-promote-success-banner">
          <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-promote-notification-banner-title">
              {{ t('pages.addOverseasSite.promoteSuccessBanner.title') }}
            </h2>
          </div>
          <div class="govuk-notification-banner__content">
            <p class="govuk-body">{{ t('pages.addOverseasSite.promoteSuccessBanner.heading') }}</p>
          </div>
        </div>
      {% endif %}

      {% if editSuccessBanner %}
        <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
             aria-labelledby="govuk-edit-notification-banner-title"
             data-module="govuk-notification-banner"
             data-testid="ors-edit-success-banner">
          <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-edit-notification-banner-title">
              {{ t('pages.addOverseasSite.editSuccessBanner.title') }}
            </h2>
          </div>
          <div class="govuk-notification-banner__content">
            <p class="govuk-body">{{ t('pages.addOverseasSite.editSuccessBanner.heading') }}</p>
          </div>
        </div>
      {% endif %}

      {% if withdrawnInterimSite %}
        {# RA-603 C4: the immediate way back. Almost every restore will be a
           mis-click noticed at once, and this fixes it without the operator
           having to find anything. It names the site, so the offer is specific
           rather than a bare "undo something", and it lasts exactly as long as
           the flash does - after that the withdrawn-sites disclosure on the ORS
           is the route back. #}
        <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
             aria-labelledby="govuk-interim-withdrawn-banner-title"
             data-module="govuk-notification-banner"
             data-testid="interim-site-withdrawn-banner">
          <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-interim-withdrawn-banner-title">
              {{ t('pages.selectOverseasSites.interimSite.withdrawnBanner.title') }}
            </h2>
          </div>
          <div class="govuk-notification-banner__content">
            <p class="govuk-body">
              {{ t('pages.selectOverseasSites.interimSite.withdrawnBanner.body') }}
              <strong data-testid="withdrawn-interim-site-name">{{ withdrawnInterimSite.siteName }}</strong>.
              {% if not readOnly %}
                <form method="post" style="display:inline" data-testid="undo-withdraw-form">
                  <input type="hidden" name="crumb" value="{{ crumb }}">
                  <input type="hidden" name="interimSiteId" value="{{ withdrawnInterimSite.interimSiteId }}">
                  <button type="submit" name="submitAction" value="restoreInterimSite"
                          class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0"
                          data-testid="undo-withdraw-button">
                    {{ t('pages.selectOverseasSites.interimSite.withdrawnBanner.undo') }}
                  </button>
                </form>
              {% endif %}
            </p>
          </div>
        </div>
      {% endif %}

      <span class="govuk-caption-l" data-testid="page-caption">{{ applicationHeader.captionText }}</span>
      <h1 class="govuk-heading-l" data-testid="page-heading">{{ heading }}</h1>

      {% if error %}
        <div class="govuk-error-summary" data-module="govuk-error-summary" role="alert" data-testid="error-summary">
          <h2 class="govuk-error-summary__title">{{ t('common.errorSummaryTitle') }}</h2>
          <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
              <li><a href="#accredited-sites" data-testid="sites-error">{{ error }}</a></li>
            </ul>
          </div>
        </div>
      {% endif %}

      {% if readOnly %}
        <div class="govuk-inset-text" data-testid="read-only-notice">
          {% if isQueriedApplication %}
            <p class="govuk-body">
              <strong>{{ t('common.readOnlySection.heading') }}</strong><br>
              {{ t('common.readOnlySection.body') }}
            </p>
          {% else %}
            <p class="govuk-body">
              <strong>{{ t('common.readOnlySubmittedSection.heading') }}</strong><br>
              {{ t('common.readOnlySubmittedSection.body') }}
            </p>
          {% endif %}
        </div>
      {% endif %}

      {% if not accreditedSites.length and not registeredSites.length and not newSites.length and not registeredSitesAddedSites.length %}

        <p class="govuk-body" data-testid="no-sites-message">
          {{ t('pages.selectOverseasSites.noSites') }}
        </p>

      {% else %}

        {% set labels = {
          change: t('pages.selectOverseasSites.changeButton'),
          withdraw: t('pages.selectOverseasSites.withdrawFromApplicationButton'),
          add: t('pages.selectOverseasSites.addToApplicationButton'),
          interimRemove: t('pages.selectOverseasSites.interimSite.removeButton'),
          interimDisclosure: t('pages.selectOverseasSites.interimSite.disclosure'),
          addAnotherInterimSite: t('pages.selectOverseasSites.interimSite.addAnother'),
          withdrawnDisclosure: t('pages.selectOverseasSites.interimSite.withdrawnDisclosure'),
          restore: t('pages.selectOverseasSites.interimSite.restoreButton')
        } %}

        {% if accreditedSites.length %}
          <h2 class="govuk-heading-m" id="accredited-sites" data-testid="accredited-heading">
            {{ t('pages.selectOverseasSites.sections.accredited') }}
          </h2>
          <table class="govuk-table select-overseas-sites-table" data-testid="accredited-sites-list">
            {# The column headings are not wanted on screen, but a data table
               without them is unusable with a screen reader - every cell loses
               the thing that names it. Hidden visually, kept in the
               accessible tree. #}
            <thead class="govuk-table__head govuk-visually-hidden">
              <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">{{ t('pages.selectOverseasSites.table.orsId') }}</th>
                <th scope="col" class="govuk-table__header">{{ t('pages.selectOverseasSites.table.siteName') }}</th>
                <th scope="col" class="govuk-table__header">{{ t('pages.selectOverseasSites.table.country') }}</th>
                {% if not readOnly %}
                  <th scope="col" class="govuk-table__header">{{ t('pages.selectOverseasSites.table.action') }}</th>
                {% endif %}
              </tr>
            </thead>
            <tbody class="govuk-table__body">
              {% for site in accreditedSites %}
                {{ overseasSiteRows({
                  site: site,
                  readOnly: readOnly,
                  crumb: crumb,
                  labels: labels,
                  testIdPrefix: 'accredited-site',
                  editTestId: 'edit-button-accredited',
                  removeFormTestId: 'remove-form-accredited',
                  removeTestId: 'remove-button-accredited',
                  removeAction: 'removeAccredited'
                }) }}
              {% endfor %}
            </tbody>
          </table>
        {% endif %}

        {% if registeredSites.length %}
          <h2 class="govuk-heading-m" data-testid="registered-heading">
            {{ t('pages.selectOverseasSites.sections.registered') }}
          </h2>
          <table class="govuk-table select-overseas-sites-table" data-testid="registered-sites-list">
            {# The column headings are not wanted on screen, but a data table
               without them is unusable with a screen reader - every cell loses
               the thing that names it. Hidden visually, kept in the
               accessible tree. #}
            <thead class="govuk-table__head govuk-visually-hidden">
              <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">{{ t('pages.selectOverseasSites.table.orsId') }}</th>
                <th scope="col" class="govuk-table__header">{{ t('pages.selectOverseasSites.table.siteName') }}</th>
                <th scope="col" class="govuk-table__header">{{ t('pages.selectOverseasSites.table.country') }}</th>
                {% if not readOnly %}
                  <th scope="col" class="govuk-table__header">{{ t('pages.selectOverseasSites.table.action') }}</th>
                {% endif %}
              </tr>
            </thead>
            <tbody class="govuk-table__body">
              {% for site in registeredSites %}
                {{ overseasSiteRows({
                  site: site,
                  readOnly: readOnly,
                  crumb: crumb,
                  labels: labels,
                  testIdPrefix: 'registered-site',
                  promote: true,
                  promoteTestId: 'add-button-registered'
                }) }}
              {% endfor %}
            </tbody>
          </table>
        {% endif %}

        {% if newSites.length %}
          <h2 class="govuk-heading-m" data-testid="new-sites-heading">
            {{ t('pages.selectOverseasSites.sections.newSites') }}
          </h2>
          <table class="govuk-table select-overseas-sites-table" data-testid="new-sites-list">
            {# The column headings are not wanted on screen, but a data table
               without them is unusable with a screen reader - every cell loses
               the thing that names it. Hidden visually, kept in the
               accessible tree. #}
            <thead class="govuk-table__head govuk-visually-hidden">
              <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">{{ t('pages.selectOverseasSites.table.orsId') }}</th>
                <th scope="col" class="govuk-table__header">{{ t('pages.selectOverseasSites.table.siteName') }}</th>
                <th scope="col" class="govuk-table__header">{{ t('pages.selectOverseasSites.table.country') }}</th>
                {% if not readOnly %}
                  <th scope="col" class="govuk-table__header">{{ t('pages.selectOverseasSites.table.action') }}</th>
                {% endif %}
              </tr>
            </thead>
            <tbody class="govuk-table__body">
              {% for site in newSites %}
                {{ overseasSiteRows({
                  site: site,
                  readOnly: readOnly,
                  crumb: crumb,
                  labels: labels,
                  testIdPrefix: 'new-site',
                  editTestId: 'edit-button-new',
                  removeFormTestId: 'remove-form-new',
                  removeTestId: 'remove-button-new',
                  removeAction: 'deleteNewSite'
                }) }}
              {% endfor %}
            </tbody>
          </table>
        {% endif %}

        {% if registeredSitesAddedSites.length %}
          <h2 class="govuk-heading-m" data-testid="registered-sites-added-heading">
            {{ t('pages.selectOverseasSites.sections.registeredSitesAdded') }}
          </h2>
          <table class="govuk-table select-overseas-sites-table" data-testid="registered-sites-added-list">
            {# The column headings are not wanted on screen, but a data table
               without them is unusable with a screen reader - every cell loses
               the thing that names it. Hidden visually, kept in the
               accessible tree. #}
            <thead class="govuk-table__head govuk-visually-hidden">
              <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">{{ t('pages.selectOverseasSites.table.orsId') }}</th>
                <th scope="col" class="govuk-table__header">{{ t('pages.selectOverseasSites.table.siteName') }}</th>
                <th scope="col" class="govuk-table__header">{{ t('pages.selectOverseasSites.table.country') }}</th>
                {% if not readOnly %}
                  <th scope="col" class="govuk-table__header">{{ t('pages.selectOverseasSites.table.action') }}</th>
                {% endif %}
              </tr>
            </thead>
            <tbody class="govuk-table__body">
              {% for site in registeredSitesAddedSites %}
                {{ overseasSiteRows({
                  site: site,
                  readOnly: readOnly,
                  crumb: crumb,
                  labels: labels,
                  testIdPrefix: 'registered-sites-added',
                  editTestId: 'edit-button-registered-added',
                  removeFormTestId: 'remove-form-registered-added',
                  removeTestId: 'remove-button-registered-added',
                  removeAction: 'revertAccreditation'
                }) }}
              {% endfor %}
            </tbody>
          </table>
        {% endif %}

        {% if not readOnly %}
          <form method="post" data-testid="continue-form">
            <input type="hidden" name="crumb" value="{{ crumb }}">
            <button type="submit" name="submitAction" value="continue"
                    class="govuk-button" data-module="govuk-button"
                    data-testid="continue-button">
              {{ t('pages.selectOverseasSites.continueButton') }}
            </button>

            <button type="submit" name="submitAction" value="saveAndComeLater"
                    class="govuk-button govuk-button--secondary" data-module="govuk-button"
                    data-testid="save-come-back-button">
              {{ t('pages.selectOverseasSites.saveAndComeLater') }}
            </button>
          </form>
        {% endif %}
      {% endif %}

      {% if not readOnly %}
        <a href="{{ addOrsUrl }}" role="button" draggable="false"
          class="govuk-button govuk-button--secondary"
          data-module="govuk-button"
          data-testid="add-new-ors-button">
            {{ t('pages.addOverseasSite.addNewButton') }}
        </a>
      {% endif %}
    </div>
  </div>
{% endblock %}
