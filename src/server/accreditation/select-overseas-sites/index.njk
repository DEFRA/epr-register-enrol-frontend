{% extends "layouts/page.njk" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {{ regulatorQueryBanner({
        queryNote: queryNote,
        heading: t('common.regulatorQuery.heading'),
        summary: querySummary,
        updateHeading: t('common.regulatorQuery.updateHeading'),
        changeLinkText: t('common.regulatorQuery.changeLink'),
        fields: regulatorQueryFields
      }) }}

      {% if successBanner %}
        <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
             aria-labelledby="govuk-notification-banner-title"
             data-module="govuk-notification-banner"
             data-testid="ors-success-banner">
          <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">
              {{ t('pages.addOverseasSite.successBanner.title') }}
            </h2>
          </div>
          <div class="govuk-notification-banner__content">
            <p class="govuk-body">{{ t('pages.addOverseasSite.successBanner.heading') }}</p>
          </div>
        </div>
      {% endif %}

      {% if interimSiteSuccessBanner %}
        <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
             aria-labelledby="govuk-interim-site-notification-banner-title"
             data-module="govuk-notification-banner"
             data-testid="interim-site-success-banner">
          <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-interim-site-notification-banner-title">
              {{ t('pages.addInterimSite.successBanner.title') }}
            </h2>
          </div>
          <div class="govuk-notification-banner__content">
            <p class="govuk-body">{{ t('pages.addInterimSite.successBanner.heading') }}</p>
          </div>
        </div>
      {% endif %}

      {% if promoteSuccessBanner %}
        <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
             aria-labelledby="govuk-promote-notification-banner-title"
             data-module="govuk-notification-banner"
             data-testid="ors-promote-success-banner">
          <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-promote-notification-banner-title">
              {{ t('pages.addOverseasSite.promoteSuccessBanner.title') }}
            </h2>
          </div>
          <div class="govuk-notification-banner__content">
            <p class="govuk-body">{{ t('pages.addOverseasSite.promoteSuccessBanner.heading') }}</p>
          </div>
        </div>
      {% endif %}

      {% if editSuccessBanner %}
        <div class="govuk-notification-banner govuk-notification-banner--success" role="alert"
             aria-labelledby="govuk-edit-notification-banner-title"
             data-module="govuk-notification-banner"
             data-testid="ors-edit-success-banner">
          <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-edit-notification-banner-title">
              {{ t('pages.addOverseasSite.editSuccessBanner.title') }}
            </h2>
          </div>
          <div class="govuk-notification-banner__content">
            <p class="govuk-body">{{ t('pages.addOverseasSite.editSuccessBanner.heading') }}</p>
          </div>
        </div>
      {% endif %}

      <h1 class="govuk-heading-l" data-testid="page-heading">{{ heading }}</h1>

      {% if error %}
        <div class="govuk-error-summary" data-module="govuk-error-summary" role="alert" data-testid="error-summary">
          <h2 class="govuk-error-summary__title">{{ t('common.errorSummaryTitle') }}</h2>
          <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
              <li><a href="#accredited-sites" data-testid="sites-error">{{ error }}</a></li>
            </ul>
          </div>
        </div>
      {% endif %}

      {% if readOnly %}
        <div class="govuk-inset-text" data-testid="read-only-notice">
          <p class="govuk-body">
            <strong>{{ t('common.readOnlySection.heading') }}</strong><br>
            {{ t('common.readOnlySection.body') }}
          </p>
        </div>
      {% endif %}

      {% if not accreditedSites.length and not registeredSites.length and not newSites.length and not registeredSitesAddedSites.length %}

        <p class="govuk-body" data-testid="no-sites-message">
          {{ t('pages.selectOverseasSites.noSites') }}
        </p>

      {% else %}

        {% if accreditedSites.length %}
          <h2 class="govuk-heading-m" id="accredited-sites" data-testid="accredited-heading">
            {{ t('pages.selectOverseasSites.sections.accredited') }}
          </h2>
          <dl class="govuk-summary-list" data-testid="accredited-sites-list">
            {% for site in accreditedSites %}
              <div class="govuk-summary-list__row" data-testid="accredited-site-row-{{ site.siteId }}">
                <dt class="govuk-summary-list__key" data-testid="accredited-site-name-{{ site.siteId }}">{{ site.siteName }}</dt>
                <dd class="govuk-summary-list__value" data-testid="accredited-site-country-{{ site.siteId }}">{{ site.country }}</dd>
                {% if not readOnly %}
                  <dd class="govuk-summary-list__actions select-overseas-sites__actions">
                    <a href="{{ site.editUrl }}" class="govuk-link"
                       data-testid="edit-button-accredited-{{ site.siteId }}">
                      {{ t('pages.selectOverseasSites.changeButton') }}
                    </a>
                    <form method="post" style="display:inline" data-testid="remove-form-accredited-{{ site.siteId }}">
                      <input type="hidden" name="crumb" value="{{ crumb }}">
                      <input type="hidden" name="siteId" value="{{ site.siteId }}">
                      <button type="submit" name="submitAction" value="removeAccredited"
                              class="govuk-button govuk-button--warning govuk-!-margin-bottom-0"
                              data-testid="remove-button-accredited-{{ site.siteId }}">
                        {{ t('pages.selectOverseasSites.removeFromAccreditationButton') }}
                      </button>
                    </form>
                  </dd>
                {% endif %}
              </div>
            {% endfor %}
          </dl>
        {% endif %}

        {% if registeredSites.length %}
          <h2 class="govuk-heading-m" data-testid="registered-heading">
            {{ t('pages.selectOverseasSites.sections.registered') }}
          </h2>
          <dl class="govuk-summary-list" data-testid="registered-sites-list">
            {% for site in registeredSites %}
              <div class="govuk-summary-list__row" data-testid="registered-site-row-{{ site.siteId }}">
                <dt class="govuk-summary-list__key" data-testid="registered-site-name-{{ site.siteId }}">{{ site.siteName }}</dt>
                <dd class="govuk-summary-list__value" data-testid="registered-site-country-{{ site.siteId }}">{{ site.country }}</dd>
                {% if not readOnly %}
                  <dd class="govuk-summary-list__actions">
                    <a href="{{ site.promoteUrl }}" role="button" draggable="false"
                       class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0"
                       data-module="govuk-button"
                       data-testid="add-button-registered-{{ site.siteId }}">
                      {{ t('pages.selectOverseasSites.addToAccreditationButton') }}
                    </a>
                  </dd>
                {% endif %}
              </div>
            {% endfor %}
          </dl>
        {% endif %}

        {% if newSites.length %}
          <h2 class="govuk-heading-m" data-testid="new-sites-heading">
            {{ t('pages.selectOverseasSites.sections.newSites') }}
          </h2>
          <dl class="govuk-summary-list" data-testid="new-sites-list">
            {% for site in newSites %}
              <div class="govuk-summary-list__row" data-testid="new-site-row-{{ site.siteId }}">
                <dt class="govuk-summary-list__key" data-testid="new-site-name-{{ site.siteId }}">{{ site.siteName }}</dt>
                <dd class="govuk-summary-list__value" data-testid="new-site-country-{{ site.siteId }}">{{ site.country }}</dd>
                {% if not readOnly %}
                  <dd class="govuk-summary-list__actions select-overseas-sites__actions">
                    <a href="{{ site.editUrl }}" class="govuk-link"
                       data-testid="edit-button-new-{{ site.siteId }}">
                      {{ t('pages.selectOverseasSites.changeButton') }}
                    </a>
                    <form method="post" style="display:inline" data-testid="remove-form-new-{{ site.siteId }}">
                      <input type="hidden" name="crumb" value="{{ crumb }}">
                      <input type="hidden" name="siteId" value="{{ site.siteId }}">
                      <button type="submit" name="submitAction" value="deleteNewSite"
                              class="govuk-button govuk-button--warning govuk-!-margin-bottom-0"
                              data-testid="remove-button-new-{{ site.siteId }}">
                        {{ t('pages.selectOverseasSites.removeFromAccreditationButton') }}
                      </button>
                    </form>
                  </dd>
                {% endif %}
              </div>
            {% endfor %}
          </dl>
        {% endif %}

        {% if registeredSitesAddedSites.length %}
          <h2 class="govuk-heading-m" data-testid="registered-sites-added-heading">
            {{ t('pages.selectOverseasSites.sections.registeredSitesAdded') }}
          </h2>
          <dl class="govuk-summary-list" data-testid="registered-sites-added-list">
            {% for site in registeredSitesAddedSites %}
              <div class="govuk-summary-list__row" data-testid="registered-sites-added-row-{{ site.siteId }}">
                <dt class="govuk-summary-list__key" data-testid="registered-sites-added-name-{{ site.siteId }}">{{ site.siteName }}</dt>
                <dd class="govuk-summary-list__value" data-testid="registered-sites-added-country-{{ site.siteId }}">{{ site.country }}</dd>
                {% if not readOnly %}
                  <dd class="govuk-summary-list__actions select-overseas-sites__actions">
                    <a href="{{ site.editUrl }}" class="govuk-link"
                       data-testid="edit-button-registered-added-{{ site.siteId }}">
                      {{ t('pages.selectOverseasSites.changeButton') }}
                    </a>
                    <form method="post" style="display:inline" data-testid="remove-form-registered-added-{{ site.siteId }}">
                      <input type="hidden" name="crumb" value="{{ crumb }}">
                      <input type="hidden" name="siteId" value="{{ site.siteId }}">
                      <button type="submit" name="submitAction" value="revertAccreditation"
                              class="govuk-button govuk-button--warning govuk-!-margin-bottom-0"
                              data-testid="remove-button-registered-added-{{ site.siteId }}">
                        {{ t('pages.selectOverseasSites.removeFromAccreditationButton') }}
                      </button>
                    </form>
                  </dd>
                {% endif %}
              </div>
            {% endfor %}
          </dl>
        {% endif %}

        {% if not readOnly %}
          <form method="post" data-testid="continue-form">
            <input type="hidden" name="crumb" value="{{ crumb }}">
            <button type="submit" name="submitAction" value="continue"
                    class="govuk-button" data-module="govuk-button"
                    data-testid="continue-button">
              {{ t('pages.selectOverseasSites.continueButton') }}
            </button>
          </form>
        {% endif %}
      {% endif %}

      {% if not readOnly %}
        <a href="{{ addOrsUrl }}" role="button" draggable="false"
          class="govuk-button govuk-button--secondary"
          data-module="govuk-button"
          data-testid="add-new-ors-button">
            {{ t('pages.addOverseasSite.addNewButton') }}
        </a>
      {% endif %}
    </div>
  </div>
{% endblock %}
