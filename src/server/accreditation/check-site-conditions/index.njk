{% extends "layouts/page.njk" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% if error %}
        <div class="govuk-error-summary" data-module="govuk-error-summary" data-testid="error-summary">
          <div role="alert">
            <h2 class="govuk-error-summary__title">{{ t('common.errorSummaryTitle') }}</h2>
            <div class="govuk-error-summary__body">
              <p>{{ error }}</p>
            </div>
          </div>
        </div>
      {% endif %}

      <h1 class="govuk-heading-l" data-testid="page-heading">{{ heading }}</h1>

      {% if siteName %}
        <p class="govuk-body" data-testid="site-name">{{ siteName }}</p>
      {% endif %}

      <p class="govuk-body" data-testid="placeholder-content">{{ t('pages.checkSiteConditions.content') }}</p>

      {% if readOnly %}
        <div class="govuk-inset-text" data-testid="read-only-notice">
          {% if isQueriedApplication %}
            <p class="govuk-body">
              <strong>{{ t('common.readOnlySection.heading') }}</strong><br>
              {{ t('common.readOnlySection.body') }}
            </p>
          {% else %}
            <p class="govuk-body">
              <strong>{{ t('common.readOnlySubmittedSection.heading') }}</strong><br>
              {{ t('common.readOnlySubmittedSection.body') }}
            </p>
          {% endif %}
        </div>
      {% else %}
        <form method="post" novalidate data-testid="confirm-form">
          <input type="hidden" name="crumb" value="{{ crumb }}">
          <button type="submit" class="govuk-button" data-module="govuk-button" data-testid="confirm-button">
            {{ t('pages.checkSiteConditions.confirmButton') }}
          </button>
        </form>
      {% endif %}

    </div>
  </div>
{% endblock %}
