{% extends "layouts/page.njk" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <a href="{{ backLink }}" class="govuk-back-link" data-testid="back-link">{{ t('common.back') }}</a>

      {% if errors or error %}
        <div class="govuk-error-summary" data-module="govuk-error-summary" data-testid="error-summary">
          <div role="alert">
            <h2 class="govuk-error-summary__title">{{ t('common.errorSummaryTitle') }}</h2>
            <div class="govuk-error-summary__body">
              {% if error %}
                <p>{{ error }}</p>
              {% else %}
                <ul class="govuk-list govuk-error-summary__list">
                  {% if errors.fullName %}
                    <li><a href="#fullName">{{ errors.fullName.text }}</a></li>
                  {% endif %}
                </ul>
              {% endif %}
            </div>
          </div>
        </div>
      {% endif %}

      <h1 class="govuk-heading-l" data-testid="page-heading">{{ heading }}</h1>

      <p class="govuk-body" data-testid="declaration-intro">{{ declarationIntro }}</p>

      <ul class="govuk-list govuk-list--bullet" data-testid="declaration-bullets">
        {% for bullet in bullets %}
          <li data-testid="declaration-bullet-{{ loop.index0 }}">{{ bullet }}</li>
        {% endfor %}
      </ul>

      <form method="post" novalidate data-testid="declaration-form">
        <input type="hidden" name="crumb" value="{{ crumb }}">

        <div class="govuk-form-group{% if errors.fullName %} govuk-form-group--error{% endif %}">
          <label class="govuk-label govuk-label--s" for="fullName">
            {{ fullNameLabel }}
          </label>
          <div id="fullName-hint" class="govuk-hint" data-testid="full-name-hint">
            {{ fullNameHint }}
          </div>
          {% if errors.fullName %}
            <p id="fullName-error" class="govuk-error-message" data-testid="full-name-error">
              <span class="govuk-visually-hidden">{{ t('common.error') }}:</span> {{ errors.fullName.text }}
            </p>
          {% endif %}
          <input class="govuk-input{% if errors.fullName %} govuk-input--error{% endif %}"
                 id="fullName"
                 name="fullName"
                 type="text"
                 autocomplete="name"
                 value="{{ fullName }}"
                 aria-describedby="fullName-hint{% if errors.fullName %} fullName-error{% endif %}"
                 data-testid="full-name-input">
        </div>

        <div class="govuk-form-group{% if errors.jobTitle %} govuk-form-group--error{% endif %}">
          <label class="govuk-label govuk-label--s" for="jobTitle">
            {{ jobTitleLabel }}
          </label>
          <div id="jobTitle-hint" class="govuk-hint" data-testid="job-title-hint">
            {{ jobTitleHint }}
          </div>
          {% if errors.jobTitle %}
            <p id="jobTitle-error" class="govuk-error-message" data-testid="job-title-error">
              <span class="govuk-visually-hidden">{{ t('common.error') }}:</span> {{ errors.jobTitle.text }}
            </p>
          {% endif %}
          <input class="govuk-input{% if errors.jobTitle %} govuk-input--error{% endif %}"
                 id="jobTitle"
                 name="jobTitle"
                 type="text"
                 autocomplete="organization-title"
                 value="{{ jobTitle }}"
                 aria-describedby="jobTitle-hint{% if errors.jobTitle %} jobTitle-error{% endif %}"
                 data-testid="job-title-input">
        </div>

        <button type="submit" name="submitAction" value="submit" class="govuk-button" data-module="govuk-button" data-testid="submit-button">
          {{ t('pages.submitDeclaration.submitButton') }}
        </button>

        <button type="submit" name="submitAction" value="saveAndComeLater" class="govuk-button govuk-button--secondary" data-module="govuk-button" data-testid="save-come-back-button">
          {{ t('pages.submitDeclaration.saveAndComeLater') }}
        </button>

      </form>

    </div>
  </div>
{% endblock %}
