{#
  Shared regulator-query banner.

  Renders only when `params.queried` is true. Scoped specifically to the
  "a regulator has queried this section" pattern — do not repurpose this for
  any other kind of status banner.

  RA-590: this banner deliberately does NOT display the officer's free-text
  query note. That note is internal-only and is communicated to the operator
  outside the application flow. Do not add it back — the banner's job is to
  say that the section is queried and to link the fields the operator can
  update, nothing more.

  Params:
    queried        (boolean, required to render) - section is under query
    heading        (string) - defaults to "Regulator query"
    summary        (string) - templated summary sentence, e.g.
                   "The regulator has identified an issue with your
                   sampling and inspection plan."
    updateHeading  (string) - defaults to "Update the application"
    changeLinkText (string) - defaults to "Change"
    fields         (array of { label, href }) - fields the operator can
                   update on this page in response to the query
#}
{% macro regulatorQueryBanner(params) %}
  {% if params.queried %}
    <div class="regulator-query-banner" data-testid="regulator-query-banner">
      <h2 class="govuk-heading-m" data-testid="regulator-query-heading">{{ params.heading | default('Regulator query') }}</h2>

      {% if params.summary %}
        <p class="govuk-body" data-testid="regulator-query-summary">{{ params.summary }}</p>
      {% endif %}

      {% if params.fields and params.fields.length > 0 %}
        <h2 class="govuk-heading-m" data-testid="regulator-query-update-heading">{{ params.updateHeading | default('Update the application') }}</h2>
        <dl class="govuk-summary-list" data-testid="regulator-query-update-list">
          {% for field in params.fields %}
            <div class="govuk-summary-list__row" data-testid="regulator-query-field-{{ loop.index0 }}">
              <dt class="govuk-summary-list__key">{{ field.label }}</dt>
              <dd class="govuk-summary-list__actions">
                <a class="govuk-link" href="{{ field.href }}" data-testid="regulator-query-change-link-{{ loop.index0 }}">
                  {{ params.changeLinkText | default('Change') }}<span class="govuk-visually-hidden"> {{ field.label }}</span>
                </a>
              </dd>
            </div>
          {% endfor %}
        </dl>
      {% endif %}
    </div>
  {% endif %}
{% endmacro %}
