{% extends "govuk/template.njk" %}

{# Import GOVUK components globally #}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "govuk/components/cookie-banner/macro.njk" import govukCookieBanner %}
{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}

{# Import custom components globally #}
{% from "heading/macro.njk" import appHeading %}
{% from "application-header/macro.njk" import appApplicationHeader %}
{% from "language-switcher/macro.njk" import languageSwitcher %}
{% from "regulator-query-banner/macro.njk" import regulatorQueryBanner %}
{% from "payment-details/macro.njk" import paymentDetailsSummary %}
{% from "session-notice/macro.njk" import sessionNotice %}

{% set mainClasses = "app-main-wrapper" %}

{% block head %}
  <link href="{{ getAssetPath('stylesheets/application.scss') }}" rel="stylesheet">
{% endblock %}

{# GOV.UK requires the cookie banner before the skip link. #}
{% block bodyStart %}
  {% if not hideCookieBanner %}
    {% set cookieBannerHeading = t('components.cookieBanner.heading') | replace('%SERVICE%', serviceName) %}
    {% if analytics.shouldAskConsent %}
      <form method="post" action="/cookies/consent" data-testid="cookie-banner-form">
        <input type="hidden" name="crumb" value="{{ crumb }}">
        <input type="hidden" name="returnUrl" value="{{ analytics.returnUrl }}">
        {{ govukCookieBanner({
          ariaLabel: cookieBannerHeading,
          attributes: { 'data-testid': 'cookie-banner' },
          messages: [{
            headingText: cookieBannerHeading,
            html: '<p class="govuk-body">' + t('components.cookieBanner.essential') + '</p><p class="govuk-body">' + t('components.cookieBanner.analytics') + '</p>',
            actions: [
              {
                text: t('components.cookieBanner.accept'),
                type: "submit",
                name: "analytics",
                value: "accepted",
                attributes: { 'data-testid': 'cookie-banner-accept' }
              },
              {
                text: t('components.cookieBanner.reject'),
                type: "submit",
                name: "analytics",
                value: "rejected",
                attributes: { 'data-testid': 'cookie-banner-reject' }
              },
              {
                text: t('components.cookieBanner.view'),
                href: cookiesPath
              }
            ]
          }]
        }) }}
      </form>
    {% elif analytics.confirmation %}
      {% set cookieSettingsLink = '<a class="govuk-link" href="' + cookiesPath + '">' + t('components.cookieBanner.changeSettingsLink') + '</a>' %}
      {{ govukCookieBanner({
        ariaLabel: cookieBannerHeading,
        attributes: { 'data-testid': 'cookie-banner-confirmation' },
        messages: [{
          html: '<p class="govuk-body">' + t('components.cookieBanner.' + analytics.confirmation) + ' ' + (t('components.cookieBanner.changeSettings') | replace('%LINK%', cookieSettingsLink)) + '</p>',
          role: "alert",
          actions: [
            {
              text: t('components.cookieBanner.hide'),
              href: analytics.returnUrl,
              attributes: { 'data-testid': 'cookie-banner-hide' }
            }
          ]
        }]
      }) }}
    {% endif %}
  {% endif %}
{% endblock %}

{% block header %}
  {# RA-487: serviceName/serviceUrl live on govukServiceNavigation, not
  govukHeader — matches Re-Ex's own header, and is also the direction
  govuk-frontend v6 moves this in regardless:
  https://github.com/alphagov/govuk-frontend/blob/main/CHANGELOG.md#move-service-name-and-navigation-links-from-the-govuk-header-to-service-navigation-component #}
  {{ govukHeader({
    homepageUrl: "https://www.gov.uk/",
    classes: "app-header",
    containerClasses: "govuk-width-container",
    useTudorCrown: true
  }) }}

  {# {{ languageSwitcher(currentPath, currentLocale, t) }} #}

  {{ govukServiceNavigation({
    serviceName: serviceName,
    serviceUrl: serviceUrl,
    navigation: navigation
  }) }}
{% endblock %}

{% block pageTitle %}
  {{ pageTitle }} | {{ serviceName }}
{% endblock %}

{% block beforeContent %}
  {{ sessionNotice(concurrentLoginNotice, t, crumb) }}
  {% if breadcrumbs.length > 1 %}
    {{ govukBreadcrumbs({
      items: breadcrumbs
    }) }}
  {% endif %}
  {% if backLink %}
    <a href="{{ backLink }}" class="govuk-back-link" data-testid="back-link">{{ backLinkText or t('common.back') }}</a>
  {% endif %}
  {% if applicationHeader and applicationHeader.showFullHeader %}
    {{ appApplicationHeader({
      operatorName: applicationHeader.operatorName,
      materialType: applicationHeader.materialType,
      siteName: applicationHeader.siteName,
      year: applicationHeader.year,
      materialLabel: t('common.applicationHeader.materialLabel'),
      siteLabel: t('common.applicationHeader.siteLabel'),
      yearLabel: t('common.applicationHeader.yearLabel')
    }) }}
  {% endif %}
{% endblock %}

{% block content %}{% endblock %}

{% block footer %}
  {{ govukFooter({
    meta: {
      items: [
        {
          href: "/contact",
          text: "Contact"
        },
        {
          href: "https://www.gov.uk/guidance/extended-producer-responsibility-for-packaging-privacy-policy",
          text: "Privacy"
        },
        {
          href: cookiesPath,
          text: "Cookies",
          attributes: { 'data-testid': 'footer-cookies' }
        },
        {
          href: "https://www.gov.uk/guidance/extended-producer-responsibility-for-packaging-accessibility-statement",
          text: "Accessibility statement"
        }
      ]
    }
  }) }}
{% endblock %}

{% block bodyEnd %}
  <script type="module" src="{{ getAssetPath('application.js') }}"></script>
{% endblock %}
