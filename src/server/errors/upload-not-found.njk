{% extends "layouts/page.njk" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l" data-testid="upload-not-found-heading">{{ pageTitle }}</h1>
      <p class="govuk-body" data-testid="upload-not-found-message">{{ t('common.errors.uploadNotFound.message') }}</p>
      <p class="govuk-body">
        <a href="{{ uploadPageUrl }}" class="govuk-link" data-testid="upload-again-link">{{ t('common.errors.uploadNotFound.uploadAgain') }}</a>
      </p>
    </div>
  </div>
{% endblock %}
