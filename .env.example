# Copy this file to .env and fill in values for local development.
# .env is gitignored and loaded automatically by nodemon via --env-file-if-exists.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── Auth — stub (default for local dev) ─────────────────────────────────────
AUTH_STUB_ENABLED=true
AUTH_CALLBACK_BASE_URL=http://localhost:3000

# ── Auth — Defra ID (operators, optional alongside stub) ────────────────────
# When set, a "Sign in with Defra ID" button appears on the stub chooser.
DEFRA_ID_CLIENT_ID=
DEFRA_ID_CLIENT_SECRET=
DEFRA_ID_DISCOVERY_URL=
DEFRA_ID_SERVICE_ID=
# Defra ID account-management page — the top nav's "Manage account" link for
# operators, same URL Re-Ex's own frontend links to.
DEFRA_ID_MANAGE_ACCOUNT_URL=https://your-account.cpdev.cui.defra.gov.uk/management/account-management/me

# ── Auth — HTTP basic auth (optional infrastructure-level protection) ────────
AUTH_BASIC_ENABLED=false
BASIC_USER=
BASIC_PASSWD=

# ── Session ──────────────────────────────────────────────────────────────────
SESSION_COOKIE_PASSWORD=the-password-must-be-at-least-32-characters-long

# ── API ──────────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:5000
API_STUB_ENABLED=true
# Sent as `Authorization: Bearer <secret>` on outbound backend calls. Must match
# AUTH_SHARED_SECRET__FRONTEND on epr-register-enrol-backend exactly. Not required
# when API_STUB_ENABLED=true or ENVIRONMENT=local.
AUTH_SHARED_SECRET__BACKEND=

# ── Re-Ex ────────────────────────────────────────────────────────────────────
# Base URL of the Re-Ex frontend service. Used to build the "Back" link, the
# fallback destination (RA-459) wherever the app would otherwise send an
# operator back to the now-test-only /operator page, and the top nav's "Home"
# link for operators (RA-487). Should never be left blank — set here rather
# than defaulted in code so it's per-environment. dev.cdp-int is the shared
# dev tier; point at a different tier's URL if you're testing against one.
REEX_FRONTEND_BASE_URL=https://epr-frontend.dev.cdp-int.defra.cloud

# ── Regulator query ──────────────────────────────────────────────────────────
# Kill switch that hides the regulator-query banner (heading, summary,
# officer free-text note, fields-to-update list) on queried section pages.
# Display-only — does not affect applicationStatus/sectionStatus, read-only/
# blocked access, or CM/backend data.
REGULATOR_QUERY_TEXT_DISABLED=false

# ── Test pages ───────────────────────────────────────────────────────────────
# Kill switch for the placeholder "/" home page and "/operator" landing page —
# neither is wired to any real application context (no site/material
# selected) and both should not be reachable in the integrated environment.
# When true, both 404 instead of rendering.
TEST_PAGES_DISABLED=false

# ── Analytics and cookie consent ─────────────────────────────────────────────
# Both must be set to show the cookie banner and allow GA4 in the CSP. The id
# below is a placeholder: it switches the banner on locally and reports nowhere.
ANALYTICS_ENABLED=true
ANALYTICS_MEASUREMENT_ID=G-LOCAL0000

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
